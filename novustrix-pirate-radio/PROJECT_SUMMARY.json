  "troubleshooting": {
    "common_issues": [
      {
        "symptom": "SSL_ERROR_BAD_CERT_DOMAIN",
        "cause": "Certificate does not cover the domain being accessed",
        "solutions": [
          "Obtain certificate with correct domain: certbot certonly -d pirate.thedagora.social",
          "Use wildcard certificate: certbot certonly -d *.thedagora.social",
          "Verify certificate: openssl s_client -connect pirate.thedagora.social:443 -servername pirate.thedagora.social"
        ]
      },
      {
        "symptom": "WebSocket connection failed",
        "cause": "Wrong service URL in widget",
        "solutions": [
          "Hardcode SERVICE_URL in src/index.ts: const SERVICE_URL = 'wss://pirate.thedagora.social/ws'",
          "Verify Nginx proxy: curl -I https://pirate.thedagora.social/ws should return HTTP 101",
          "Check service logs: journalctl -u pirate-radio-service -f"
        ]
      },
      {
        "symptom": "FFmpeg not found",
        "cause": "FFmpeg not installed on system",
        "solutions": [
          "Ubuntu/Debian: sudo apt install ffmpeg",
          "macOS: brew install ffmpeg",
          "Alpine: apk add ffmpeg",
          "Verify: ffmpeg -version"
        ]
      },
      {
        "symptom": "No audio in stream",
        "cause": "Multiple possible issues",
        "solutions": [
          "Check browser console for microphone permission errors",
          "Verify service receives chunks: check logs for 'Sending audio chunk'",
          "Verify Icecast connection: service logs should show 'Connected to Icecast server'",
          "Test Icecast directly: curl http://localhost:8000/ should return HTML"
        ]
      },
      {
        "symptom": "Widget won't load in Matrix room",
        "cause": "Mixed content or CORS issue",
        "solutions": [
          "Ensure widget URL is HTTPS: https://pirate.thedagora.social",
          "Check CORS headers in Nginx",
          "Verify CORS_ORIGINS includes Matrix homeserver URL"
        ]
      }
    ],
    "debug_commands": {
      "check_services": "sudo systemctl status pirate-radio-{service,widget,icecast}",
      "view_logs": {
        "service": "journalctl -u pirate-radio-service -f",
        "widget": "journalctl -u pirate-radio-widget -f",
        "icecast": "journalctl -u icecast -f",
        "nginx": "sudo tail -f /var/log/nginx/error.log"
      },
      "test_connections": {
        "widget": "curl http://localhost:8081",
        "service": "curl http://localhost:8082/health",
        "icecast": "curl http://localhost:8000/",
        "websocket": "wscat -c ws://localhost:8082/ws"
      },
      "network": {
        "check_ports": "sudo netstat -tulnp | grep -E '(8081|8082|8000)'",
        "test_ssl": "openssl s_client -connect pirate.thedagora.social:443 -servername pirate.thedagora.social"
      }
    }
  },
