  "architecture": {
    "overview": "Matrix Room → Widget (Browser) → WebSocket → Broadcast Service (Node.js) → FFmpeg → Icecast → Listeners",
    "data_flow": {
      "widget_to_service": {
        "protocol": "WebSocket (wss://)",
        "port": 8082,
        "endpoint": "/ws",
        "message_types": [
          "join_room",
          "leave_room", 
          "start_broadcast",
          "stop_broadcast",
          "audio_chunk (binary)",
          "icecast_config",
          "get_state",
          "ping"
        ]
      },
      "service_to_icecast": {
        "protocol": "Icecast Source Protocol",
        "method": "FFmpeg stdin pipe",
        "port": 8000,
        "authentication": "username/password"
      }
    },
    "components": {
      "matrix_widget": {
        "technology": "TypeScript + Matrix Widget API",
        "responsibilities": [
          "Microphone capture via getUserMedia()",
          "Audio encoding (WebM/Opus)",
          "WebSocket connection management",
          "Queue management UI",
          "Status display",
          "User interface"
        ]
      },
      "broadcast_service": {
        "technology": "Node.js + Express + WebSocket",
        "responsibilities": [
          "WebSocket server",
          "Room/queue management",
          "Audio chunk buffering",
          "FFmpeg process management",
          "Icecast streaming",
          "REST API (health, stats)"
        ]
      },
      "icecast_server": {
        "technology": "Icecast 2",
        "responsibilities": [
          "Stream hosting",
          "Listener management",
          "Mount point handling",
          "Stats reporting"
        ]
      }
    }
  },
  "key_findings": {
    "security": [
      {
        "issue": "Mixed content blocking",
        "description": "HTTPS Matrix homeservers cannot load HTTP widgets due to browser security policies",
        "solution": "All components must be served over HTTPS (wss:// for WebSocket)",
        "impact": "Critical - widget would not load in production Matrix servers"
      },
      {
        "issue": "Iframe location detection",
        "description": "window.location in Matrix widgets returns the homeserver URL, not the widget URL",
        "solution": "Hardcode service URLs or pass via widget parameters",
        "impact": "WebSocket connection would fail to wrong domain"
      }
    ],
    "technical": [
      {
        "issue": "Browser audio streaming limitations",
        "description": "Browsers cannot directly stream to Icecast via raw TCP/source protocol",
        "solution": "Intermediate broadcast service using FFmpeg as source client",
        "impact": "Required architecture design"
      },
      {
        "issue": "Audio format compatibility",
        "description": "MediaRecorder API produces WebM/Opus which needs transcoding for Icecast",
        "solution": "FFmpeg re-encodes to MP3/Ogg/AAC for Icecast compatibility",
        "impact": "Service must handle audio encoding"
      }
    ],
    "deployment": [
      {
        "issue": "FFmpeg dependency",
        "description": "Broadcast service requires FFmpeg for audio encoding",
        "solution": "Install FFmpeg on host or in Docker container",
        "impact": "Service will not start without FFmpeg"
      }
    ]
  },
  "deployment_options": {
    "docker_compose": {
      "description": "Containerized deployment with Docker",
      "pro": [
        "Isolated environment",
        "Easy to deploy",
        "Portable across systems",
        "Version controlled"
      ],
      "con": [
        "Requires Docker knowledge",
        "Slightly higher resource usage"
      ],
      "services": [
        {
          "name": "widget",
          "image": "nginx:alpine",
          "port": 8081,
          "volumes": ["./dist:/usr/share/nginx/html:ro"],
          "purpose": "Serves static widget files"
        },
        {
          "name": "service", 
          "image": "custom (service/Dockerfile)",
          "port": 8082,
          "environment": [
            "PORT=8082",
            "ICECAST_HOST=icecast",
            "ICECAST_PORT=8000",
            "ICECAST_USERNAME=source",
            "ICECAST_PASSWORD=hackme"
          ],
          "purpose": "Broadcast service with WebSocket"
        },
        {
          "name": "icecast",
          "image": "ghcr.io/icecast/icecast-server:latest",
          "port": 8000,
          "purpose": "Icecast streaming server"
        }
      ],
      "network": "Custom bridge network (pirate-net)",
      "nginx": {
        "required": true,
        "purpose": "HTTPS termination and reverse proxy",
        "configuration": "Path-based routing: / → widget, /ws → service"
      }
    },
    "systemd": {
      "description": "Native system services",
      "pro": [
        "Direct control",
        "Better performance",
        "Standard Linux administration",
        "Easier logging with journalctl"
      ],
      "con": [
        "Requires manual setup",
        "Less portable",
        "Dependency management on host"
      ],
      "services": [
        {
          "name": "pirate-radio-service",
          "type": "Node.js application",
          "port": 8082,
          "user": "node",
          "working_directory": "/opt/claude-minstral/novustrix-pirate-radio/service"
        },
        {
          "name": "pirate-radio-widget",
          "type": "http-server",
          "port": 8081,
          "user": "node",
          "working_directory": "/opt/claude-minstral/novustrix-pirate-radio"
        },
        {
          "name": "icecast",
          "type": "icecast2",
          "port": 8000,
          "user": "icecast2",
          "configuration": "/etc/icecast2/icecast.xml"
        }
      ]
    },
    "recommendation": "systemd for production servers, Docker Compose for development/testing"
  },
