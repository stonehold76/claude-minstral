  "systemd_units": {
    "pirate-radio-service.service": {
      "description": "Broadcast service as systemd unit",
      "type": "simple",
      "user": "node",
      "working_directory": "/opt/claude-minstral/novustrix-pirate-radio/service",
      "exec_start": "/usr/bin/node /opt/claude-minstral/novustrix-pirate-radio/service/index.js",
      "environment": [
        "NODE_ENV=production",
        "PORT=8082",
        "ICECAST_HOST=localhost",
        "ICECAST_PORT=8000",
        "ICECAST_USERNAME=source",
        "ICECAST_PASSWORD=hackme"
      ],
      "restart": "on-failure",
      "commands": [
        "sudo systemctl start pirate-radio-service",
        "sudo systemctl stop pirate-radio-service",
        "sudo systemctl restart pirate-radio-service",
        "sudo systemctl status pirate-radio-service",
        "sudo systemctl enable pirate-radio-service",
        "journalctl -u pirate-radio-service -f"
      ]
    },
    "pirate-radio-widget.service": {
      "description": "Widget static server as systemd unit",
      "type": "simple",
      "user": "node",
      "working_directory": "/opt/claude-minstral/novustrix-pirate-radio",
      "exec_start": "/usr/bin/http-server . -p 8081 -c-1",
      "requires": "http-server npm package",
      "install": "sudo npm install -g http-server",
      "restart": "on-failure",
      "commands": [
        "sudo systemctl start pirate-radio-widget",
        "sudo systemctl stop pirate-radio-widget",
        "sudo systemctl restart pirate-radio-widget"
      ]
    },
    "icecast.service": {
      "description": "Icecast server as systemd unit",
      "type": "simple",
      "user": "icecast2",
      "exec_start": "/usr/bin/icecast2 -c /etc/icecast2/icecast.xml",
      "requires": "icecast2 package",
      "install": "sudo apt install icecast2",
      "configuration": "/etc/icecast2/icecast.xml",
      "restart": "on-failure"
    }
  },
  "nginx_configuration": {
    "description": "Reverse proxy for HTTPS termination",
    "server_block": {
      "listen": "443 ssl",
      "server_name": "pirate.thedagora.social",
      "ssl_certificate": "/etc/letsencrypt/live/pirate.thedagora.social/fullchain.pem",
      "ssl_certificate_key": "/etc/letsencrypt/live/pirate.thedagora.social/privkey.pem",
      "locations": {
        "/": {
          "proxy_pass": "http://localhost:8081",
          "purpose": "Widget static files"
        },
        "/ws": {
          "proxy_pass": "http://localhost:8082",
          "upgrade": true,
          "purpose": "WebSocket connection"
        },
        "/health": {
          "proxy_pass": "http://localhost:8082/health",
          "purpose": "Service health check"
        },
        "/stats": {
          "proxy_pass": "http://localhost:8082/stats",
          "purpose": "Service statistics"
        }
      }
    },
    "http_redirect": {
      "listen": "80",
      "return": "301 https://$server_name$request_uri"
    }
  },
