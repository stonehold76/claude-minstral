# Novustrix Pirate Radio Service Configuration
# Copy this file to .env and fill in your values

# Server Configuration
PORT=8082
HOST=0.0.0.0

# Icecast Configuration (primary stream)
ICECAST_HOST=localhost
ICECAST_PORT=8000
ICECAST_MOUNT=/stream
ICECAST_USERNAME=source
ICECAST_PASSWORD=hackme
ICECAST_STREAM_NAME=Novustrix Pirate Radio

# Audio Configuration
AUDIO_FORMAT=mp3
AUDIO_BITRATE=128000
AUDIO_SAMPLE_RATE=44100
AUDIO_CHANNELS=2

# FFmpeg path (default: use system ffmpeg)
FFMPEG_PATH=ffmpeg

# Shared secret for widget authentication (optional)
# Generate with: openssl rand -hex 32
SHARE_SECRET=

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:8080,http://localhost:8081,https://matrix.example.com

# Log level (error, warn, info, debug)
LOG_LEVEL=info
