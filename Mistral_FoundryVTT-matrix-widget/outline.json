    }
  ],
  "open_questions": [
    {
      "id": "Q1",
      "question": "FoundryVTT Connection Method: Socket.IO or Module API?",
      "options": [
        {
          "name": "Socket.IO",
          "pros": ["Works externally", "No module installation required"],
          "cons": ["Authentication challenges", "May break with updates"]
        },
        {
          "name": "Module API",
          "pros": ["More reliable", "Better authentication", "Access to internal APIs"],
          "cons": ["Requires module installation", "Tight coupling"]
        }
      ],
      "recommendation": "Start with Socket.IO for external bridge, add Module API later"
    },
    {
      "id": "Q2",
      "question": "Ghost User Permissions: What can Matrix-only users do?",
      "options": [
        "Chat only",
        "Chat + see dice rolls",
        "Chat + limited game state access",
        "Full player permissions"
      ],
      "recommendation": "Chat + see dice rolls (configurable per-room)"
    },
    {
      "id": "Q3",
      "question": "Message History: Should the bridge sync historical messages?",
      "options": [
        "Full sync",
        "Partial sync (last N messages)",
        "No sync",
        "On-demand sync"
      ],
      "recommendation": "Partial sync (last 100 messages) on bridge startup"
    },
    {
      "id": "Q4",
      "question": "E2E Encryption: How to handle encrypted Matrix rooms?",
      "options": [
        "Require bot to be in room (cannot decrypt)",
        "Warn users that E2E rooms won't bridge",
        "Ignore encrypted rooms",
        "Attempt to decrypt with user keys"
      ],
      "recommendation": "Warn users and skip encrypted rooms (bot cannot decrypt)"
    },
    {
      "id": "Q5",
      "question": "Rate Limiting: What limits should be imposed?",
      "suggestions": {
        "messages_per_second": 5,
        "messages_per_minute": 60,
        "file_upload_size_mb": 10,
        "api_calls_per_second": 10
      }
    },
    {
      "id": "Q6",
      "question": "Deployment Model: Single instance or per-world?",
      "options": [
        "Single bridge serving multiple Foundry instances",
        "Dedicated bridge per Foundry server",
        "Dedicated bridge per Foundry world"
      ],
      "recommendation": "Single bridge with multiple world support"
    }
  ],
