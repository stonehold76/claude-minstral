  "glossary": {
    "terms": {
      "Matrix": "Decentralized communication protocol",
      "Homeserver": "Matrix server that hosts user accounts and rooms",
      "Application Service": "Matrix component that can send/receive events as if it were a user",
      "FoundryVTT": "Virtual Tabletop for playing RPG games online",
      "Socket.IO": "JavaScript library for realtime web applications",
      "E2E Encryption": "End-to-End Encryption in Matrix rooms",
      "Ghost User": "Synthetic user created in one system to represent a user from the other",
      "Room": "Matrix chat room / FoundryVTT game world",
      "Event": "Matrix message or state change",
      "Module": "FoundryVTT plugin/extension"
    }
  }
}
