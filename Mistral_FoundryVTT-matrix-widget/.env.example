# Matrix-FoundryVTT Bridge Environment Variables
# Customized for: GameMaster bot on thedagora.social
# Room: !ioIGXPMvsniZqjrndd:thedagora.social
# 
# Copy this file to .env and fill in the missing values
# 
# IMPORTANT: Never commit .env to version control

# =============================================================================
# FOUNDRYVTT CONFIGURATION
# =============================================================================

# FoundryVTT server host
FOUNDRY_HOST=foundry.cognitivecosmos.games

# FoundryVTT server port
FOUNDRY_PORT=30000

# Use SSL/TLS for Foundry connection
FOUNDRY_USE_SSL=true

# Foundry API port (if different from main port)
FOUNDRY_API_PORT=30001

# =============================================================================
# MATRIX CONFIGURATION
# =============================================================================

# Matrix homeserver URL
MATRIX_HOMESERVER=https://thedagora.social/

# Matrix bot username
MATRIX_USERNAME=@gamemaster:thedagora.social

# Matrix bot display name
MATRIX_DISPLAY_NAME=GameMaster

# Matrix access token for the bot
# Get this from your Matrix client or server admin
# DO NOT SHARE THIS TOKEN
MATRIX_ACCESS_TOKEN=place_secret_here

# Matrix device ID (optional)
MATRIX_DEVICE_ID=JISMWUXVGG

# =============================================================================
# LICENSE CONFIGURATION
# =============================================================================

# Licensed Matrix room ID (only this room can use the bridge)
LICENSED_ROOM_ID=!ioIGXPMvsniZqjrndd:thedagora.social

# Enforce license check (true/false)
ENFORCE_LICENSE=true

# =============================================================================
# BRIDGE SERVER CONFIGURATION
# =============================================================================

# Port for the bridge server
BRIDGE_PORT=3001

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Enable debug mode (true/false)
DEBUG_MODE=false

# =============================================================================
# SCENE SYNC CONFIGURATION
# =============================================================================

# Enable scene background sync (true/false)
SCENE_SYNC_ENABLED=true

# Polling interval in milliseconds
SCENE_SYNC_INTERVAL=5000

# Sync background images (true/false)
SCENE_SYNC_BACKGROUND=true

# Use thumbnails for smaller files (true/false)
SCENE_SYNC_THUMBNAIL=false

# Maximum image size in bytes (10MB default)
SCENE_SYNC_MAX_IMAGE_SIZE=10485760

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable dice roll support (true/false)
FEATURE_DICE_ROLLS=true

# Enable character sync (true/false)
FEATURE_CHARACTER_SYNC=true

# Enable item sync (true/false)
FEATURE_ITEM_SYNC=true

# Enable scene sync (true/false)
FEATURE_SCENE_SYNC=true

# Enable license enforcement (true/false)
FEATURE_LICENSE_ENFORCEMENT=true

# Enable ghost users (Application Service only) (true/false)
FEATURE_GHOST_USERS=false

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Allowed origins for CORS (comma-separated)
# Leave empty to allow all
CORS_ORIGINS=https://thedagora.social

# =============================================================================
# ADMIN USERS
# =============================================================================

# Comma-separated list of Matrix user IDs with admin privileges
ADMIN_USERS=@gamemaster:thedagora.social

# =============================================================================
# ROOM MAPPINGS
# =============================================================================

# Map Matrix room IDs to Foundry world IDs
# Format: room_id=world_id,room_id2=world_id2
ROOM_MAPPINGS=!ioIGXPMvsniZqjrndd:thedagora.social=your-foundry-world-id
