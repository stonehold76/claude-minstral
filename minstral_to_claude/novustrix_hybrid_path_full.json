    {
      "name": "Phase 3: Hybrid Implementation",
      "duration": "12-24 Months",
      "goal": "Implement Matrix standards in Novustrix while maintaining Novustrix-only features as extensions.",
      "tasks": [
        {
          "category": "Dual-Mode Features",
          "features": [
            {
              "feature": "Roles",
              "standard_mode": "m.role event",
              "novustrix_mode": "com.novustrix.role (extra metadata)",
              "fallback": "Ignore com.novustrix.role if m.role exists"
            },
            {
              "feature": "Widgets",
              "standard_mode": "Matrix Widget API + extensions",
              "novustrix_mode": "Novustrix widget host",
              "fallback": "Render as link if Widget API unsupported"
            },
            {
              "feature": "Studios",
              "standard_mode": "m.room.type: \"m.studio\"",
              "novustrix_mode": "com.novustrix.studio (extra features)",
              "fallback": "Treat as regular room"
            },
            {
              "feature": "Cross-Arts Bus",
              "standard_mode": "m.widget.bus",
              "novustrix_mode": "com.novustrix.bus (extra channels)",
              "fallback": "Ignore bus messages"
            },
            {
              "feature": "Ping Roles",
              "standard_mode": "@role → m.mentions.user_ids (Path A)",
              "novustrix_mode": "Novustrix-only",
              "fallback": "@role is plain text in other clients"
            }
          ]
        },
